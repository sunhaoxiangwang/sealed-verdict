# Sealed Verdict environment variable names. WP1 (in-memory backend) needs none of these.
# Copy to .env locally; .env is gitignored. Never commit real values.

# Juror model access (apps/jurors, teammate-owned)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional live AML model overrides:
OPENAI_MODEL=gpt-5-mini
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Terse durable actors (live mode, apps/actors/bridge). Local dev needs neither:
# TERSE_ACTOR_URL defaults to http://127.0.0.1:7100/v1/projects/local/actors.
TERSE_ACTOR_URL=
TERSE_API_KEY=

# Agent Relay (live mode). Local engine: RELAY_BASE_URL=http://127.0.0.1:8787.
# The workspace key stays in the bridge; jurors receive only their own agent tokens.
RELAY_WORKSPACE_KEY=
RELAY_BASE_URL=

# Supabase ingestion (out of WP1 scope)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_API_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPERSERVE_API_KEY=
